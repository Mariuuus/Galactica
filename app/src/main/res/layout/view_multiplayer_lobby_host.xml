<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="20dp"
    android:background="@color/transparent_space_glow"
    android:gravity="center"
    android:minWidth="500dp"
    android:orientation="vertical"
    android:padding="10dp">

        <TextView
            android:id="@+id/testConnectionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed-medium"
            android:text="Spiel konfigurieren"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:textColor="@color/white"
            android:textStyle="bold|italic" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Spalten:"
                        android:textColor="@color/space_glow" />

                    <SeekBar
                        android:id="@+id/seek_cols"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="15"
                        android:min="4"
                        android:minWidth="80dp"
                        android:progress="9"
                        android:progressTint="#FFFFFF" />

                    <TextView
                        android:id="@+id/cols_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9"
                        android:textColor="@color/space_glow" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Zeilen:"
                        android:textColor="@color/space_glow" />

                    <SeekBar
                        android:id="@+id/seek_rows"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="13"
                        android:min="3"
                        android:minWidth="80dp"
                        android:progress="7"
                        android:progressTint="#FFFFFF" />

                    <TextView
                        android:id="@+id/rows_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7"
                        android:textColor="@color/space_glow" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Planeten:"
                        android:textColor="@color/space_glow" />

                    <SeekBar
                        android:id="@+id/seek_planets"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="10"
                        android:min="1"
                        android:minWidth="80dp"
                        android:progress="4"
                        android:progressTint="#FFFFFF" />

                    <TextView
                        android:id="@+id/my_planets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:textColor="@color/space_glow" />
                </LinearLayout>

            </LinearLayout>

            <Space
                android:layout_width="40dp"
                android:layout_height="wrap_content">
            </Space>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Bomben:"
                        android:textColor="@color/space_glow" />

                    <SeekBar
                        android:id="@+id/seek_bombs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="10"
                        android:min="0"
                        android:minWidth="80dp"
                        android:progress="2"
                        android:progressTint="#FFFFFF" />

                    <TextView
                        android:id="@+id/bombs_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textColor="@color/space_glow" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Raumschiffe:"
                        android:textColor="@color/space_glow" />

                    <SeekBar
                        android:id="@+id/seek_rocketships"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="10"
                        android:min="0"
                        android:minWidth="80dp"
                        android:progress="1"
                        android:progressTint="#FFFFFF" />

                    <TextView
                        android:id="@+id/rocketships_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textColor="@color/space_glow" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    <Button
        android:id="@+id/start_host_lobby_button"
        style="@android:style/Widget.Material.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Spiel STARTEN" />
</LinearLayout>
